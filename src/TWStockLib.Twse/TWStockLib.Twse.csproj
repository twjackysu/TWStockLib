<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>TWStockLib</RootNamespace>

    <!-- 保留原有 NuGet 套件名 TWStockLib：現有使用者 `dotnet add package TWStockLib`
         照常可用，並自動帶入 TWStockLib.Core。組件名為 TWStockLib.Twse。 -->
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>TWStockLib</PackageId>
    <Version>3.0.0</Version>
    <Description>台灣股票類別庫 — 證交所（TSE）/ 櫃買（OTC）資料來源實作。</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TWStockLib.Twse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TWStockLib.Core\TWStockLib.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="[1.5.0,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.0,)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="[8.0.0,)" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="[8.0.0,)" />
    <!-- 不在 Microsoft.NETCore.App 共用架構內（只隨 ASP.NET Core 提供），需另外參考 -->
    <PackageReference Include="System.Threading.RateLimiting" Version="[8.0.0,)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
